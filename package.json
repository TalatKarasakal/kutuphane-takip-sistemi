{
  "name": "kutuphane-takip-sistemi",
  "productName": "Kütüphanem",
  "description": "Yerel kitap, film ve dizi koleksiyonu takip uygulaması",
  "author": "Talat Karasakal",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "ci:check": "npm run tracker:check && npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "tracker:check": "node scripts/validate-project-tracker.mjs",
    "pack:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=${CSC_IDENTITY_AUTO_DISCOVERY:-false} electron-builder --mac dmg --universal --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "pack:all": "npm run pack:mac && npm run pack:win && npm run pack:linux"
  },
  "build": {
    "appId": "com.talatkarasakal.kutuphanem",
    "productName": "Kütüphanem",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "CHANGELOG.md",
      "package.json"
    ],
    "afterPack": "./electron/afterPack.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.plist",
      "entitlementsInherit": "electron/entitlements.plist"
    },
    "dmg": {
      "backgroundColor": "#111827",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "TalatKarasakal",
      "repo": "kutuphane-takip-sistemi"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@zxing/browser": "^0.2.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.441.0",
    "nanoid": "^5.1.16",
    "papaparse": "^5.4.1",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  }
}
